# ==========================================
# Frontend Environment Variables Template
# ==========================================

# URL pointing to the FastAPI scientific calculation engine
# In local development: http://localhost:8000/api/v1
# In production on Vercel: https://<your-render-service>.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google Gemini API key used by /api/ai/interpretation
GEMINI_API_KEY=your_gemini_api_key_here
